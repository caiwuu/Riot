{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口能力集。自定义命令在 build.rs 里声明，这里逐个放行 —— 声明「存在」和授予「可用」是两件事。",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "dialog:default",
    "notification:default",
    "opener:default",
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "$HOME/**" },
        { "path": "$TEMP/**" },
        { "path": "/tmp/**" }
      ]
    },
    "allow-subscribe-session",
    "allow-send-turn",
    "allow-regenerate-turn",
    "allow-interrupt",
    "allow-respond-permission",
    "allow-set-permission-mode",
    "allow-get-config",
    "allow-app-version",
    "allow-check-update",
    "allow-set-config",
    "allow-set-api-key",
    "allow-add-project",
    "allow-create-session",
    "allow-probe-dirs",
    "allow-path-exists",
    "allow-list-sessions",
    "allow-get-history",
    "allow-delete-session",
    "allow-rename-session",
    "allow-remove-project",
    "allow-test-connection",
    "allow-test-search-backend",
    "allow-list-models",
    "allow-set-session-sampling",
    "allow-detect-venvs",
    "allow-set-session-python-venv",
    "allow-set-session-system-prompt",
    "allow-set-session-thinking",
    "allow-browser-open",
    "allow-browser-close",
    "allow-browser-navigate",
    "allow-browser-history",
    "allow-browser-reload",
    "allow-browser-state",
    "allow-browser-new-tab",
    "allow-browser-close-tab",
    "allow-browser-select-tab",
    "allow-browser-resize",
    "allow-browser-input",
    "allow-browser-scope-list",
    "allow-browser-scope-revoke",
    "allow-term-open",
    "allow-term-write",
    "allow-term-resize",
    "allow-term-close",
    "allow-term-list",
    "allow-term-attach",
    "allow-term-share",
    "allow-term-busy",
    "allow-read-image",
    "allow-read-file-bytes",
    "allow-clipboard-paths",
    "allow-mcp-status",
    "allow-mcp-restart",
    "allow-mcp-export-json",
    "allow-mcp-import-json",
    "allow-skills-list",
    "allow-sandbox-status",
    "allow-sandbox-install",
    "allow-sandbox-uninstall",
    "allow-packs-status",
    "allow-packs-install",
    "allow-packs-uninstall",
    "allow-queue-list",
    "allow-queue-remove",
    "allow-queue-take",
    "allow-session-compact",
    "allow-session-changes",
    "allow-session-git-changes",
    "allow-slash-commands",
    "allow-slash-expand",
    "allow-hooks-list",
    "allow-search-files"
  ]
}

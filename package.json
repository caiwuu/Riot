{
  "name": "riot",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "gen:schema": "cargo run -p riot-protocol --bin gen_schema",
    "gen:types": "json2ts --input schemas/protocol.json --output src/bridge/generated.ts --bannerComment \"/* 由 schemas/protocol.json 生成，勿手改。改 crates/riot-protocol 里的 Rust 类型后跑 pnpm gen */\" --additionalProperties false",
    "gen": "pnpm gen:schema && pnpm gen:types",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@file-viewer/react": "workspace:*",
    "@file-viewer/renderer-pdf": "workspace:*",
    "@file-viewer/renderer-presentation": "workspace:*",
    "@file-viewer/renderer-spreadsheet": "workspace:*",
    "@file-viewer/renderer-text": "workspace:*",
    "@file-viewer/renderer-word": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.16.1",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@file-viewer/vite-plugin": "workspace:*",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.0.0"
  }
}

# 复制为 .env 后再改：
#   cp .env.example .env
#   openssl rand -hex 32   # 把输出填进 SEARXNG_SECRET

# 镜像标签。可钉死版本，例如 2026.8.22-9fea41204
SEARXNG_VERSION=latest

# 只绑本机，局域网访问不到。要对外监听再改成 0.0.0.0
SEARXNG_HOST=127.0.0.1
SEARXNG_PORT=8080
SEARXNG_BASE_URL=http://127.0.0.1:8080/

# 必填。openssl rand -hex 32
SEARXNG_SECRET=
